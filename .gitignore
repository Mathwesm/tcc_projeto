# Environment
.env
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Tooling caches
.ruff_cache/
.mypy_cache/
.pytest_cache/
.hypothesis/
htmlcov/
.coverage
.coverage.*

# Runtime artifacts
logs/
*.log
data/
# Everything under outputs/ is generated: trained adapters (tens of MB each),
# accumulated results and figures. The numbers that matter are transcribed into the
# README and the write-up, where they are read rather than diffed.
outputs/*
!data/processed/
data/processed/*

# tests/fixtures/ is intentionally NOT ignored: the CI needs those samples to run.

# Editors
.vscode/
.idea/
.DS_Store

# The split manifests are tracked on purpose. It is small, contains only ids from a
# public dataset, and is what lets a run on Kaggle prove it used the same
# train/validation split as the run here -- a seed alone cannot, because it only
# reproduces a permutation of whatever row order the library happened to produce.
!data/processed/splits/
data/processed/splits/*
!data/processed/splits/*.json
